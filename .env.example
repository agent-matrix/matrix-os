# GitPilot is the default AI coder (integrated, not replaced). Plan mode = dry-run.
MATRIX_GITPILOT_URL=https://ruslanmv-gitpilot.hf.space
# SelfRepair control plane that diagnoses, plans, and delegates coding to GitPilot.
MATRIX_SELFREPAIR_URL=https://ruslanmv-selfrepair.hf.space
POSTGRES_PASSWORD=matrix-local-password
POSTGRES_USER=matrix
POSTGRES_DB=matrixos
HITL_DEFAULT=true
AUTOPILOT_ENABLED=false
ALLOW_PRODUCTION_DEPLOY=false
ALLOW_SELF_MODIFICATION=false
ALLOW_NETWORK_IN_SANDBOX=false
