{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCard",
  "type": "object",
  "required": [
    "agent_id",
    "name",
    "version",
    "capabilities",
    "risk_profile"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_profile": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "protocols": {
      "type": "array"
    }
  }
}