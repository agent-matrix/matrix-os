{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceBundle",
  "type": "object",
  "required": [
    "evidence_id",
    "plan_id",
    "status",
    "artifacts",
    "digests"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "partial",
        "cancelled"
      ]
    },
    "artifacts": {
      "type": "array"
    },
    "digests": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    }
  }
}