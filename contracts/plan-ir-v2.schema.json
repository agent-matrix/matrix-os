{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-matrix.dev/contracts/plan-ir-v2.schema.json",
  "title": "PlanIRV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","plan_id","goal","strategy","uncertainty","steps"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "strategy": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "alternatives_considered": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id","objective","capability","success_criteria","verifiers","risk"],
        "properties": {
          "step_id": {"type": "string"},
          "objective": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "allowed_paths": {"type": "array", "items": {"type": "string"}},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "expected_outputs": {"type": "array", "items": {"type": "string"}},
          "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rollback": {"type": ["string","null"]},
          "risk": {"enum": ["low","medium","high","critical"]},
          "estimated_cost": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}