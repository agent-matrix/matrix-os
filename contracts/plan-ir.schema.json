{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanIR",
  "type": "object",
  "required": [
    "plan_id",
    "goal",
    "risk",
    "steps",
    "verification"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "required_capabilities"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object"
    }
  }
}