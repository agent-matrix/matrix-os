{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-matrix.dev/contracts/run-envelope-v2.schema.json",
  "title": "RunEnvelopeV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","trace_id","tenant_id","actor_id","goal","stage","created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "parent_event_id": {"type": ["string","null"]},
    "goal": {"type": "string", "minLength": 1},
    "stage": {"enum": ["created","observing","remembering","discovering","deliberating","governing","funding","simulating","compiling","executing","verifying","evaluating","learning","waiting_human","completed","failed","cancelled","rolled_back"]},
    "created_at": {"type": "string"},
    "policy_version": {"type": ["string","null"]},
    "budget_version": {"type": ["string","null"]},
    "input_hash": {"type": ["string","null"]},
    "provenance": {"type": "object", "additionalProperties": true},
    "signature": {"type": ["string","null"]}
  }
}